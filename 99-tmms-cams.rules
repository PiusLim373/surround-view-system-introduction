# Fisheye cams — single capture node (index0) per port
SUBSYSTEM=="video4linux", ENV{ID_PATH}=="platform-3610000.xhci-usb-0:2.2:1.0", ATTR{index}=="0", SYMLINK+="front_cam"
SUBSYSTEM=="video4linux", ENV{ID_PATH}=="platform-3610000.xhci-usb-0:2.3:1.0", ATTR{index}=="0", SYMLINK+="left_cam"
SUBSYSTEM=="video4linux", ENV{ID_PATH}=="platform-3610000.xhci-usb-0:3.2:1.0", ATTR{index}=="0", SYMLINK+="right_cam"
SUBSYSTEM=="video4linux", ENV{ID_PATH}=="platform-3610000.xhci-usb-0:3.4:1.0", ATTR{index}=="0", SYMLINK+="back_cam"

